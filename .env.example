# ShapePilot environment. Nothing here is a secret: the app uses no client
# secret and relies on managed identity in production. Copy to .env and adjust,
# or supply these through App Service configuration.

# Production uses PORT=3000 and requires it explicitly.
NODE_ENV=development
PORT=8080

# --- Identity ---------------------------------------------------------------
# The tenant whose tokens are accepted, and ShapePilot's own API audience.
SHAPEPILOT_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# AAD_TENANT_ID is the canonical infrastructure alias. If both are set they
# must agree.
# AAD_TENANT_ID=00000000-0000-0000-0000-000000000000
SHAPEPILOT_API_AUDIENCE=api://shapepilot
SHAPEPILOT_API_SCOPE=access_as_user
# SHAPEPILOT_JWKS_URI=
# Comma-separated GUIDs granted the admin role the first time they sign in.
# SHAPEPILOT_ADMIN_OIDS=

# --- Database ---------------------------------------------------------------
# Production requires the absolute canonical DB_PATH and
# SQLITE_JOURNAL_MODE=DELETE, and always refuses to create a missing database.
# SHAPEPILOT_DB_PATH remains a development compatibility alias.
SHAPEPILOT_DB_PATH=data/shapepilot.db
# DB_PATH=/home/data/shapepilot.db
# SQLITE_JOURNAL_MODE=DELETE
SHAPEPILOT_DB_BUSY_TIMEOUT_MS=5000
# Production pins this explicit fail-closed value.
# SHAPEPILOT_DB_ALLOW_CREATE=0
# First allocation only. Exact value 1 creates a zero-domain-row authority once;
# remove immediately after direct production readiness succeeds.
# SHAPEPILOT_INITIALIZE_EMPTY_DB=1

# --- Recovery ---------------------------------------------------------------
# BACKUP_ROOT is mandatory in production. Recovery scratch defaults below that
# root unless RECOVERY_WORK_ROOT is supplied explicitly.
# SHAPEPILOT_ARTIFACT_STORE_DIR=/mnt/shapepilot-backups
# BACKUP_ROOT=/home/data/backups/shapepilot
# RECOVERY_WORK_ROOT=/home/data/recovery/shapepilot

# --- Development auth bypass ------------------------------------------------
# Lets local development and the test suite exercise the real routes without an
# Entra tenant. Startup THROWS if this is set with NODE_ENV=production.
# SHAPEPILOT_DEV_AUTH=1
# SHAPEPILOT_DEV_AUTH_OID=11111111-1111-1111-1111-111111111111
# SHAPEPILOT_DEV_AUTH_TENANT_ID=
# SHAPEPILOT_DEV_AUTH_NAME=Local Developer
# SHAPEPILOT_DEV_AUTH_EMAIL=developer@localhost
# SHAPEPILOT_DEV_AUTH_ROLE=admin

# --- Frontend (build-time) --------------------------------------------------
# VITE_AUTH_MODE=development skips the sign-in gate and sends no token.
# VITE_AUTH_MODE=development
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
# Canonical infrastructure aliases:
# VITE_AZURE_CLIENT_ID=
# VITE_AZURE_TENANT_ID=
VITE_API_SCOPE=api://shapepilot/access_as_user
