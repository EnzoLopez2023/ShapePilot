# ShapePilot environment. No real credentials belong in this example.
# Entra uses no client secret and Foundry uses managed identity in production.
# Optional Bambu credentials must be supplied through a server-only secret store.

# Production uses PORT=3000 and requires it explicitly.
NODE_ENV=development
PORT=8080

# --- Identity ---------------------------------------------------------------
# The tenant whose tokens are accepted and ShapePilot's API identifier URI.
# Entra v2 tokens carry the API client ID (without api://) in their aud claim;
# the server derives that expected claim from this standard App ID URI.
SHAPEPILOT_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# AAD_TENANT_ID is the canonical infrastructure alias. If both are set they
# must agree.
# AAD_TENANT_ID=00000000-0000-0000-0000-000000000000
SHAPEPILOT_API_AUDIENCE=api://11111111-1111-1111-1111-111111111111
SHAPEPILOT_API_SCOPE=access_as_user
# SHAPEPILOT_JWKS_URI=
# Comma-separated GUIDs granted the admin role the first time they sign in.
# SHAPEPILOT_ADMIN_OIDS=

# --- Database ---------------------------------------------------------------
# Production requires the absolute canonical DB_PATH and
# SQLITE_JOURNAL_MODE=DELETE, and always refuses to create a missing database.
# SHAPEPILOT_DB_PATH remains a development compatibility alias.
SHAPEPILOT_DB_PATH=data/shapepilot.db
# DB_PATH=/home/data/shapepilot.db
# SQLITE_JOURNAL_MODE=DELETE
SHAPEPILOT_DB_BUSY_TIMEOUT_MS=5000
# Production pins this explicit fail-closed value.
# SHAPEPILOT_DB_ALLOW_CREATE=0
# First allocation only. Exact value 1 creates a zero-domain-row authority once;
# remove immediately after direct production readiness succeeds.
# SHAPEPILOT_INITIALIZE_EMPTY_DB=1

# --- Recovery ---------------------------------------------------------------
# BACKUP_ROOT is mandatory in production. Recovery scratch defaults below that
# root unless RECOVERY_WORK_ROOT is supplied explicitly.
# SHAPEPILOT_ARTIFACT_STORE_DIR=/mnt/shapepilot-backups
# BACKUP_ROOT=/home/data/backups/shapepilot
# RECOVERY_WORK_ROOT=/home/data/recovery/shapepilot

# --- Development auth bypass ------------------------------------------------
# Lets local development and the test suite exercise the real routes without an
# Entra tenant. Startup THROWS if this is set with NODE_ENV=production.
# SHAPEPILOT_DEV_AUTH=1
# SHAPEPILOT_DEV_AUTH_OID=11111111-1111-1111-1111-111111111111
# SHAPEPILOT_DEV_AUTH_TENANT_ID=
# SHAPEPILOT_DEV_AUTH_NAME=Local Developer
# SHAPEPILOT_DEV_AUTH_EMAIL=developer@localhost
# SHAPEPILOT_DEV_AUTH_ROLE=admin

# --- AI design assistant (Azure AI Foundry) ---------------------------------
# A resource dedicated to this app so its inference cost is attributable on its
# own. Both values are non-secret. Production authenticates with the Web App's
# managed identity (scope https://ai.azure.com/.default), so no key is needed;
# leaving these unset simply disables the AI routes rather than failing startup.
# They must be set together.
# AZURE_AI_FOUNDRY_ENDPOINT=https://aif-shapepilot-prod.openai.azure.com/openai/v1/
# The deployment name, passed as the model. Reading photographs of a keycap set
# needs a vision-capable model behind it; nothing in code asserts that, and a
# deployment without vision surfaces as a typed `ai_rejected` while every other
# route -- and typing a set in by hand -- keeps working.
# AZURE_AI_FOUNDRY_DEPLOYMENT=shapepilot-designer
# Local development only: a key avoids needing `az login`. It is ignored in
# production, and an unresolved Key Vault reference is ignored everywhere --
# App Service passes such a reference through verbatim, and treating that as a
# credential fails every call while looking correctly configured.
# AZURE_OPENAI_API_KEY=

# --- Admin: EL-ement Statistics ---------------------------------------------
# Optional, server-only. Monitoring remains disabled until an administrator
# verifies the configured Bambu account, selects a printer and enables it.
# Never use a VITE_ prefix, paste tokens into the UI, or commit a populated file.
# Supply the value from the host's secret store / resolved Key Vault reference.
# SHAPEPILOT_BAMBU_ACCESS_TOKEN=
# global uses the global Bambu account service; china uses the China service.
# SHAPEPILOT_BAMBU_REGION=global
# After rotating the token, restart ShapePilot and verify in Admin again.
# No password, LAN access code, camera URL, or automatic refresh token is used.

# --- Frontend (build-time) --------------------------------------------------
# VITE_AUTH_MODE=development skips the sign-in gate and sends no token.
# VITE_AUTH_MODE=development
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
# Canonical infrastructure aliases:
# VITE_AZURE_CLIENT_ID=
# VITE_AZURE_TENANT_ID=
VITE_API_SCOPE=api://11111111-1111-1111-1111-111111111111/access_as_user

# Web Push reorder reminders (optional). All three or none; absent turns push
# off without failing startup. Generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# In production the private key is a Key Vault reference, like the AI key.
# SHAPEPILOT_VAPID_PUBLIC_KEY=
# SHAPEPILOT_VAPID_PRIVATE_KEY=
# SHAPEPILOT_VAPID_SUBJECT=mailto:you@example.com
