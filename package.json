{
  "name": "shapepilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Approachable AI-assisted 2D/3D design, viewing, editing, and fabrication.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch server/index.ts",
    "build": "npm run build:native && vite build",
    "build:client": "vite build",
    "build:native": "node scripts/build-native.ts",
    "postinstall": "npm run build:native",
    "preview": "vite preview",
    "start": "node scripts/start-production.ts",
    "stamp:build": "node scripts/stamp-build-identity.ts",
    "db:init": "node scripts/init-db.ts",
    "check:architecture": "node scripts/check-architecture.ts",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "ci": "npm run check:architecture && npm run typecheck && npm run lint && npm test && npm run build",
    "ci:deploy": "npm run ci",
    "deploy:migration-check": "node scripts/check-deploy-migration.ts",
    "deploy:monitor-check": "node scripts/check-deploy-monitor.ts",
    "deploy:rbac-check": "node scripts/check-deploy-rbac.ts",
    "deploy:acr-check": "node scripts/check-acr-contract.ts",
    "test:watch": "vitest",
    "legacy:export": "node scripts/legacy-export.ts",
    "legacy:import": "node scripts/legacy-import.ts",
    "legacy:reconcile": "node scripts/reconcile.ts",
    "recovery": "node scripts/recovery.ts"
  },
  "dependencies": {
    "@azure/msal-browser": "^4.24.0",
    "@azure/msal-react": "^3.0.24",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "better-sqlite3": "12.4.1",
    "earcut": "^3.0.2",
    "express": "^5.1.0",
    "fflate": "^0.8.2",
    "jose": "^6.1.0",
    "polygon-clipping": "^0.15.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5",
    "three": "^0.181.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/earcut": "^3.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^28.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
