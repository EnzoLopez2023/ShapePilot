{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo",
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "server",
    "lib",
    "scripts",
    "src/rack",
    "src/caliper",
    "src/swatch",
    "src/geometry/vec.ts",
    "src/geometry/bands.ts",
    "src/geometry/skadis.ts",
    "src/geometry/primitives.ts",
    "src/geometry/boolean.ts",
    "src/geometry/tjunction.ts",
    "src/geometry/mesh.ts",
    "src/geometry/triangulate.ts",
    "src/export/stl.ts",
    "src/export/cutLayers.ts",
    "src/export/shaperSvg.ts",
    "src/features/shaper-designer/templates/cuttingBoards.ts",
    "src/features/shaper-designer/templates/outline.ts",
    "src/features/shaper-designer/templates/kitchen.ts",
    "src/features/shaper-designer/templates/sceneParts.ts",
    "src/features/shaper-designer/cutDrawing.ts",
    "src/geometry/sceneShapes.ts",
    "src/geometry/nest.ts",
    "src/model/scene.ts",
    "src/export/zip.ts",
    "src/export/threemf.ts",
    "src/export/xlsx.ts",
    "src/features/filaments/model/labels.ts",
    "src/model/machines.ts",
    "src/model/document.ts",
    "test/helpers",
    "test/parity",
    "test/fixtures"
  ],
  "exclude": [
    "test/parity/referenceGeometry.test.ts",
    "scripts/build-fastener-coupon.ts"
  ]
}
