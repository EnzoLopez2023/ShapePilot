node_modules/
native/build/
dist/
coverage/
.DS_Store
*.local

# App-owned SQLite authority in development, plus its rollback journal.
data/
*.db
*.db-journal

# Recovery artifacts and legacy export bundles never belong in the repository.
artifacts/
legacy-export/

# Switch-tester geometry. The source model is someone else's and the tray and
# cover are cut from its own footprint, so neither it nor its derivatives are
# published from this public repository -- only the script that makes them.
# See models/Switch tester/README.txt.
models/Switch tester/*.stl

# Scratch output. The published STL set lives in models/, which IS tracked.
out/

# Scratch extraction of the pinned Hearth source used during the port.
.porting-source/

# Machine-local design-hook state. The design sidecar itself is committed.
.impeccable/hook.cache.json
.impeccable/config.local.json

.env
.env.*
!.env.example

# Claude Code machine-local settings
.claude/settings.local.json
